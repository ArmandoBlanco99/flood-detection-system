# Reference only: the application does not automatically load .env files.
# Set these values in your shell before starting the corresponding entry point.

# Read by: python src/Flask_Server.py
# development enables Flask debug mode; any other value disables it.
FLASK_ENV=development

# Read by: python wsgi.py (always debug=False).
# src/Flask_Server.py uses port 5000 regardless of PORT.
PORT=5000

# ESP32 Wi-Fi credentials belong in the ignored firmware/arduino_secrets.h file.
# Copy firmware/arduino_secrets.h.example to create it; never commit real secrets.
